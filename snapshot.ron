// Headless snapshot config for the terrain-mesh renderer.
// The snapshot tool accepts a full `rot: Some((i, j, k, w))` quaternion
// dumped by F12; that reproduces the live game view EXACTLY. The look_at
// fallback ignores roll about the forward axis.
(
    pos: (16.864, 5.183, 44.422),
    look_at: Some((9.949, -1.764, 42.455)),
    fov_y: 1.000,
    extent: (1280, 800),
    output: "snap_mesh.png",
)
