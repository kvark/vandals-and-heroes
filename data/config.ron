(
    map: "fostral",
    car: "OxidizeMonk",
    environment: Some("Fostral"),
    // Debug-snow density: one particle per N m² of world surface area.
    // Smaller = denser snow = slower frame. 0 disables snow entirely.
    snow_area_per_particle_m2: 50.0,
    // Terrain mesh fit quality in 0..=1. 1.0 fits to within one height
    // quantisation step; every 0.25 below doubles the tolerance (and roughly
    // halves the triangle count).
    terrain_quality: 0.75,
    record: Some((
        path: "state.log.ron",
        format: Ron,
    )),
)
